{
  "private": true,
  "name": "my-connection",
  "version": "0.12.0",
  "main": "expo-router/entry",
  "description": "Understand your connection.",
  "license": "MIT",
  "author": {
    "name": "Matheus Zanin",
    "url": "https://zanin.dev"
  },
  "homepage": "https://myconnection.zanin.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/MattZ6/my-connection"
  },
  "bugs": {
    "url": "https://github.com/MattZ6/my-connection/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "network",
    "wifi",
    "android",
    "typescript",
    "zanin.dev"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint:ci": "biome ci .",
    "format": "biome format --write",
    "licenses:generate": "bunx npm-license-crawler -onlyDirectDependencies -json ./src/assets/licenses.json"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.3",
    "@expo/material-symbols": "0.1.1",
    "@expo/ui": "58.0.27",
    "@legendapp/list": "3.7.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.28.0",
    "expo": "58.0.23",
    "expo-application": "58.1.2",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.18",
    "expo-device": "58.0.5",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-intent-launcher": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-localization": "58.0.5",
    "expo-location": "58.0.20",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.7",
    "i18next": "26.7.1",
    "react": "19.3.0",
    "react-i18next": "17.1.12",
    "react-native": "0.88.1",
    "react-native-mmkv": "4.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/netinfo"
      ]
    }
  }
